#!/usr/bin/env python3
"""Generate CAC arena worlds for Gazebo Harmonic. See cac_sim/README.md."""
import argparse
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent


def _setup_paths():
    """Return the packaged share/cac_sim dir (or None in the source tree) and fix sys.path.

    Works from the source tree, from an installed (but not sourced) prefix, and when sourced.
    """
    if (HERE.parent / 'cac_sim_gen').is_dir():                  # source tree
        sys.path.insert(0, str(HERE.parent))
        return None
    prefix = HERE.parent.parent                                  # <prefix>/lib/cac_sim/..
    for pat in ('python3*/site-packages', 'python3*/dist-packages', 'python3/dist-packages'):
        for cand in sorted((prefix / 'lib').glob(pat)):
            if (cand / 'cac_sim_gen').is_dir():
                sys.path.insert(0, str(cand))
    share = prefix / 'share' / 'cac_sim'
    return share if share.is_dir() else None


def main(argv=None):
    share = _setup_paths()
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--layout', default='schematic',
                    help='schematic | empty | random | path/to/layout.yaml (default: schematic)')
    ap.add_argument('--seed', type=int, default=1, help='random layout seed (default 1)')
    ap.add_argument('--count', type=int, default=1, help='random: seeds SEED..SEED+COUNT-1')
    ap.add_argument('--config', default=None, help='arena.yaml override (default: packaged)')
    ap.add_argument('--out', required=True, help='output directory; one sub-directory per world')
    ap.add_argument('--markers', action='store_true', help='add ArUco marker boards')
    ap.add_argument('--marker-preset', default=None,
                    help='marker layout from arena.yaml markers.presets '
                         '(frame_inner | perimeter_walls)')
    ap.add_argument('--sitcams', action='store_true', help='add the two situational cameras')
    ap.add_argument('--overlay', action='store_true', help='draw zones and target (visual only)')
    ap.add_argument('--low-gfx', action='store_true', help='no shadows (slow laptops)')
    a = ap.parse_args(argv)

    from cac_sim_gen import config, layout as layout_mod, world
    cfg_path = a.config or (share / 'config' / 'arena.yaml' if share else None)
    cfg = config.resolve(config.load_config(cfg_path), a.marker_preset)

    layouts = []
    if a.layout == 'random':
        for s in range(a.seed, a.seed + max(a.count, 1)):
            lay = layout_mod.random_layout(cfg, s)
            lay['name'] = f'seed_{s:04d}'
            layouts.append(lay)
    elif a.layout == 'empty':
        layouts.append(config.empty_layout(cfg))
    elif share and not Path(a.layout).suffix:
        layouts.append(config.load_layout(share / 'layouts' / f'{a.layout}.yaml'))
    else:
        layouts.append(config.load_layout(a.layout))

    if a.markers:
        try:
            world.check_marker_support(cfg)
        except world.MarkerError as e:
            print(f'error: --markers: {e}', file=sys.stderr)
            return 2
        for p in world.check_markers(cfg):
            print(f'warning [markers]: {p}', file=sys.stderr)
    for lay in layouts:
        # hard = physically wrong (overlaps, outside, no path); strict-only = rulebook deviations
        hard = layout_mod.check_layout(cfg, lay, strict=False)
        for p in hard:
            print(f'warning [{lay["name"]}]: {p}', file=sys.stderr)
        for p in layout_mod.check_layout(cfg, lay, strict=True):
            if p not in hard:
                print(f'info [{lay["name"]}]: {p}', file=sys.stderr)
        try:
            root = world.write_world(cfg, lay, a.out, markers=a.markers, sitcams=a.sitcams,
                                     overlay=a.overlay, low_gfx=a.low_gfx)
        except world.MarkerError as e:
            print(f'error: --markers: {e}', file=sys.stderr)
            return 2
        print(f'{root}\n  gz sim -r {root / "arena.sdf"}')
    print(f'WARNING: {a.out}/<name>/truth/ is ground truth for the test harness and scoring only. '
          'The robot stack must never read it.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
